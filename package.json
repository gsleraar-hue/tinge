{
  "name": "tinge",
  "productName": "Tinge",
  "version": "1.0.0",
  "description": "Colour black-and-white photos with DDColor, entirely on your own computer",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "author": "Jan-Wolter",
  "repository": {
    "type": "git",
    "url": "https://github.com/gsleraar-hue/tinge.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never",
    "dist-mac": "electron-builder --mac --publish never",
    "icon": "node dev/make-icon.js",
    "test": "node dev/selftest.js"
  },
  "build": {
    "appId": "nl.gsleraar.tinge",
    "productName": "Tinge",
    "files": [
      "main.js",
      "preload.js",
      "models.js",
      "renderer/**",
      "build/icon.ico",
      "build/icon.png"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ],
    "afterPack": "build/after-pack.js",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/{darwin,linux}/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Tinge-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Tinge-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.photography",
      "darkModeSupport": true,
      "identity": null,
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/{win32,linux}/**"
      ]
    },
    "dmg": {
      "title": "Tinge",
      "artifactName": "Tinge-${version}-${arch}.dmg"
    }
  },
  "dependencies": {
    "onnxruntime-node": "^1.30.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
